# HTTP Server WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# mDNS
CONFIG_MDNS_MAX_SERVICES=10

# LittleFS
CONFIG_LITTLEFS_MAX_PARTITIONS=3

#
# ESP System Settings
#
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80 is not set
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# PSRAM for S3
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# DSP library
CONFIG_DSP_MAX_FFT_SIZE_4096=y

# Compiler
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# I2C Driver - Use New Generation (NG) driver for ESP32-S3
CONFIG_DRIVER_I2C_NG=y
# CONFIG_DRIVER_I2C_LEGACY is not set

# Partition table (custom CSV is provided via board_build.partitions in platformio.ini)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size for ESP32-S3-DevKitC-1 N16R8 (16 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Wi-Fi: enable SoftAP so the access point shows up after flashing
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# CONFIG_FATFS_LFN_NONE is not set
# CONFIG_FATFS_LFN_HEAP is not set
CONFIG_FATFS_LFN_STACK=y


CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_IDF_TARGET_ESP32S3=y

# I2C: проект использует НОВЫЙ (NG) драйвер (driver/i2c_master.h, i2c_master_bus_*).
# Старый legacy-драйвер запрещён, иначе на старте возникает
# "CONFLICT! driver_ng is not allowed to be used with this old driver" и reboot loop.
# В ESP-IDF 5.3 конфликт проверяется при вызове i2c_param_config() (старый API),
# поэтому достаточно НЕ использовать старый драйвер в коде.
# CONFIG_DRIVER_I2C_LEGACY is not set

# Bluetooth: в данном проекте НЕ включается (см. README ниже):
# прошивка не содержит BLE/NimBLE стека, подключение к роботу возможно только по Wi-Fi/USB.
# CONFIG_BT_ENABLED is not set